# nginx config TEMPLATE - rendered at container start by the official image entrypoint
# (envsubst on /etc/nginx/templates/*.template -> /etc/nginx/conf.d/). Only DEFINED environment
# variables are substituted, so nginx variables like $host stay intact.
#
# Required env: BACKEND_UPSTREAM (default set in the Dockerfile: http://backend:4000)
#
# Routing (must stay identical to the Vite dev proxy in vite.config.ts):
#   /api/*       -> ${BACKEND_UPSTREAM}/*      (prefix stripped: /api/v1/auth/login -> /v1/auth/login)
#   /socket.io/* -> ${BACKEND_UPSTREAM}        (optional Realtime module; websocket upgrade)
#   /assets/*    -> hashed build output, cached for 1 year
#   everything else -> index.html (SPA fallback), never cached

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    # Container healthcheck (Dockerfile HEALTHCHECK).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM}/;
        proxy_http_version 1.1;
        # Host of the UPSTREAM, not the browser host: platforms such as Render route by Host, and an
        # https upstream needs SNI. The browser host travels in X-Forwarded-Host.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_ssl_server_name on;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        client_max_body_size 1m;
    }

    location /socket.io/ {
        proxy_pass ${BACKEND_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        # Host of the UPSTREAM, not the browser host: platforms such as Render route by Host, and an
        # https upstream needs SNI. The browser host travels in X-Forwarded-Host.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Vite emits content-hashed file names here: safe to cache forever.
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/snippets/security-headers.conf;
    }
}
