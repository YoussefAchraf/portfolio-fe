# Copy to .env. Every VITE_* variable is PUBLIC (bundled into the browser code) - no secrets, ever.
# Values read by app code are validated at startup by src/shared/lib/env.ts.

# --- Read by the app (src/shared/lib/env.ts) ---
# Base URL of the API as seen by the browser. Keep "/api": the Vite dev proxy and nginx strip it.
VITE_API_BASE_URL=/api
# Default UI language when the browser language is not supported (en | fr).
VITE_DEFAULT_LOCALE=en

# --- Read only by vite.config.ts (dev server proxy) ---
VITE_BACKEND_UPSTREAM=http://localhost:4000
